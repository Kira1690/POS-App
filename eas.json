{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://payment.gsmnyc.com",
        "EXPO_PUBLIC_WS_URL": "wss://payment.gsmnyc.com"
      }
    },
    "production": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://payment.gsmnyc.com",
        "EXPO_PUBLIC_WS_URL": "wss://payment.gsmnyc.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
