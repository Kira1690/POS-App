// Authentication Service Database Schema
// Multi-Restaurant POS System - DbDiagram.io Format
// Generated: 2025-09-28
// Service: Authentication and User Management (Shared Multi-Tenant)

Project "POS Authentication Service" {
  database_type: 'PostgreSQL'
  Note: '''
    # Authentication Service Database Schema

    **Pattern**: Shared Multi-Tenant Database
    **Purpose**: Centralized user authentication and restaurant management
    **Scale**: 5 restaurants, 500 users, high read volume

    ## Key Features
    - Multi-restaurant user management
    - Role-based access control (RBAC)
    - Session and device tracking
    - Comprehensive audit trail
    - Support for superadmin (cross-restaurant) users

    ## Security Considerations
    - Password hashing with bcrypt
    - Session token management
    - Device fingerprinting
    - Multi-factor authentication support
    - Audit trail for all authentication events
  '''
}

// Enums and Types
enum user_role {
  restaurant_staff
  kitchen_staff
  manager
  admin
  superadmin
}

enum session_status {
  active
  expired
  revoked
  invalid
}

enum device_type {
  mobile
  tablet
  desktop
  pos_terminal
  kitchen_display
}

enum auth_event_type {
  login_success
  login_failure
  logout
  password_change
  role_change
  account_disabled
  account_enabled
  session_expired
  device_registered
}

// Core Authentication Tables

Table users as U {
  id uuid [pk, default: `gen_random_uuid()`]
  email text [unique, note: 'Primary login for managers/admin/superadmin']
  employee_id text [note: 'Employee ID for staff login']
  password_hash text [not null, note: 'bcrypt hashed password']
  salt text [not null, note: 'Password salt for additional security']

  // Personal Information
  first_name text [not null]
  last_name text [not null]
  phone_number text
  profile_image_url text

  // Role and Restaurant Assignment
  role user_role [not null, default: 'restaurant_staff']
  default_restaurant_id text [note: 'Primary restaurant assignment']

  // Account Status
  is_active boolean [default: true]
  is_verified boolean [default: false]
  email_verified_at timestamptz
  phone_verified_at timestamptz

  // Security Settings
  mfa_enabled boolean [default: false]
  mfa_secret text [note: 'TOTP secret for 2FA']
  backup_codes text[] [note: 'Recovery codes for MFA']

  // Login Tracking
  last_login_at timestamptz
  last_login_ip inet
  login_count integer [default: 0]
  failed_login_attempts integer [default: 0]
  locked_until timestamptz [note: 'Account lockout timestamp']

  // Password Management
  password_changed_at timestamptz [default: 'now()']
  password_expires_at timestamptz
  must_change_password boolean [default: false]

  // Audit Fields
  created_at timestamptz [default: 'now()']
  created_by uuid [note: 'User who created this account']
  updated_at timestamptz [default: 'now()']
  updated_by uuid [note: 'User who last updated this account']
  is_deleted boolean [default: false]
  deleted_at timestamptz
  deleted_by uuid

  // Constraints
  Note: '''
    Constraints:
    - Either email OR employee_id must be provided (not both null)
    - Superadmin users must have email (no employee_id)
    - Non-superadmin users must have default_restaurant_id
    - Phone number format validation
    - Password complexity requirements
  '''

  indexes {
    email [unique, name: 'idx_users_email']
    employee_id [name: 'idx_users_employee_id']
    (email, employee_id) [unique, name: 'idx_users_login_unique']
    default_restaurant_id [name: 'idx_users_restaurant']
    role [name: 'idx_users_role']
    (is_active, is_deleted) [name: 'idx_users_status']
    last_login_at [name: 'idx_users_last_login']
  }
}

Table restaurants as R {
  id text [pk, note: 'Format: rest_001, rest_002, etc.']
  name text [not null]
  legal_name text [note: 'Legal business name']

  // Contact Information
  address text
  city text
  state text
  postal_code text
  country text [default: 'US']
  phone text
  email text
  website text

  // Business Information
  business_type text [note: 'Quick Service, Casual Dining, etc.']
  cuisine_type text[] [note: 'Italian, Chinese, American, etc.']
  tax_id text [note: 'Business tax identification number']
  license_number text [note: 'Business license number']

  // Management
  manager_id uuid [note: 'Primary manager user ID']
  owner_id uuid [note: 'Restaurant owner user ID']

  // Operational Settings
  timezone text [default: 'UTC']
  currency text [default: 'USD']
  operating_hours jsonb [note: 'Weekly operating schedule']

  // System Configuration
  settings jsonb [note: 'Restaurant-specific system settings']
  features_enabled text[] [note: 'Enabled feature flags']
  integrations jsonb [note: 'External system integration configs']

  // Subscription and Billing
  subscription_plan text [default: 'basic']
  subscription_status text [default: 'active']
  billing_email text
  next_billing_date date

  // Status and Audit
  is_active boolean [default: true]
  onboarded_at timestamptz
  last_activity_at timestamptz

  created_at timestamptz [default: 'now()']
  created_by uuid
  updated_at timestamptz [default: 'now()']
  updated_by uuid
  is_deleted boolean [default: false]
  deleted_at timestamptz
  deleted_by uuid

  indexes {
    name [name: 'idx_restaurants_name']
    manager_id [name: 'idx_restaurants_manager']
    (is_active, is_deleted) [name: 'idx_restaurants_status']
    subscription_status [name: 'idx_restaurants_subscription']
    timezone [name: 'idx_restaurants_timezone']
  }
}

// Multi-Restaurant User Access
Table user_restaurant_access as URA {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  restaurant_id text [not null]
  role user_role [not null]

  // Access Control
  permissions text[] [note: 'Specific permissions within this restaurant']
  access_level text [default: 'standard', note: 'standard, limited, full']

  // Grant Information
  granted_by uuid [not null, note: 'User who granted this access']
  granted_at timestamptz [default: 'now()']
  granted_reason text [note: 'Reason for granting access']

  // Restrictions
  access_restrictions jsonb [note: 'Time-based or feature restrictions']
  ip_restrictions inet[] [note: 'Allowed IP addresses']

  // Status
  is_active boolean [default: true]
  effective_from timestamptz [default: 'now()']
  effective_until timestamptz [note: 'Optional access expiration']

  // Audit
  revoked_at timestamptz
  revoked_by uuid
  revoked_reason text

  created_at timestamptz [default: 'now()']
  updated_at timestamptz [default: 'now()']

  indexes {
    (user_id, restaurant_id) [unique, name: 'idx_ura_user_restaurant']
    user_id [name: 'idx_ura_user']
    restaurant_id [name: 'idx_ura_restaurant']
    granted_by [name: 'idx_ura_granted_by']
    (is_active, effective_from, effective_until) [name: 'idx_ura_active_period']
  }
}

// Session Management
Table user_sessions as US {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  restaurant_id text [note: 'Active restaurant context']

  // Session Tokens
  access_token_hash text [not null, note: 'Hashed access token']
  refresh_token_hash text [not null, note: 'Hashed refresh token']
  token_family uuid [not null, note: 'Token family for refresh rotation']

  // Session Details
  session_name text [note: 'User-friendly session name']
  status session_status [not null, default: 'active']

  // Device and Location
  device_id uuid [note: 'Registered device identifier']
  user_agent text [note: 'Browser/app user agent']
  ip_address inet [not null]
  location_info jsonb [note: 'Geolocation data if available']

  // Timing
  expires_at timestamptz [not null]
  last_activity_at timestamptz [default: 'now()']
  idle_timeout_minutes integer [default: 30]

  // Security
  is_mobile boolean [default: false]
  requires_mfa boolean [default: false]
  mfa_verified_at timestamptz

  // Session Termination
  ended_at timestamptz
  end_reason text [note: 'logout, timeout, revoked, etc.']

  created_at timestamptz [default: 'now()']

  indexes {
    user_id [name: 'idx_sessions_user']
    restaurant_id [name: 'idx_sessions_restaurant']
    status [name: 'idx_sessions_status']
    expires_at [name: 'idx_sessions_expires']
    device_id [name: 'idx_sessions_device']
    last_activity_at [name: 'idx_sessions_activity']
    token_family [name: 'idx_sessions_token_family']
  }
}

// Device Registration and Management
Table registered_devices as RD {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  restaurant_id text [note: 'Restaurant where device is registered']

  // Device Information
  device_name text [not null, note: 'User-assigned device name']
  device_type device_type [not null]
  device_fingerprint text [not null, note: 'Unique device identifier']

  // Hardware Information
  platform text [note: 'iOS, Android, Windows, etc.']
  browser text [note: 'Chrome, Safari, Firefox, etc.']
  app_version text [note: 'Mobile app version']
  os_version text

  // Registration Details
  registration_method text [note: 'qr_code, manual, auto']
  registration_ip inet

  // Trust and Security
  is_trusted boolean [default: false]
  trust_score integer [default: 50, note: '0-100 trust score']

  // Usage Tracking
  last_used_at timestamptz
  usage_count integer [default: 0]

  // Status
  is_active boolean [default: true]

  // Audit
  created_at timestamptz [default: 'now()']
  updated_at timestamptz [default: 'now()']
  deactivated_at timestamptz
  deactivated_by uuid
  deactivated_reason text

  indexes {
    user_id [name: 'idx_devices_user']
    restaurant_id [name: 'idx_devices_restaurant']
    device_fingerprint [unique, name: 'idx_devices_fingerprint']
    (user_id, device_fingerprint) [unique, name: 'idx_devices_user_fingerprint']
    device_type [name: 'idx_devices_type']
    (is_active, is_trusted) [name: 'idx_devices_status']
    last_used_at [name: 'idx_devices_last_used']
  }
}

// Authentication Events and Audit Trail
Table auth_events as AE {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  restaurant_id text
  session_id uuid
  device_id uuid

  // Event Details
  event_type auth_event_type [not null]
  event_description text [not null]
  event_data jsonb [note: 'Additional event-specific data']

  // Context Information
  ip_address inet
  user_agent text
  location_info jsonb

  // Security Analysis
  risk_score integer [note: '0-100 risk assessment']
  anomaly_flags text[] [note: 'Detected anomalies']

  // Correlation
  related_event_id uuid [note: 'Related authentication event']
  correlation_id uuid [note: 'Group related events']

  // Outcome
  success boolean [not null]
  failure_reason text [note: 'Reason for failed authentication']
  action_taken text [note: 'System action taken']

  // Timing
  occurred_at timestamptz [default: 'now()']
  processed_at timestamptz [default: 'now()']

  // Retention (for compliance)
  retention_category text [default: 'standard']
  archive_after timestamptz

  indexes {
    user_id [name: 'idx_auth_events_user']
    restaurant_id [name: 'idx_auth_events_restaurant']
    event_type [name: 'idx_auth_events_type']
    occurred_at [name: 'idx_auth_events_time']
    (success, event_type) [name: 'idx_auth_events_success_type']
    session_id [name: 'idx_auth_events_session']
    device_id [name: 'idx_auth_events_device']
    ip_address [name: 'idx_auth_events_ip']
    correlation_id [name: 'idx_auth_events_correlation']
  }
}

// Password Reset and Security
Table password_reset_tokens as PRT {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]

  // Token Information
  token_hash text [not null, note: 'Hashed reset token']
  token_type text [default: 'email', note: 'email, sms, admin']

  // Delivery Information
  sent_to text [not null, note: 'Email or phone number']
  delivery_method text [not null, note: 'email, sms']

  // Security
  ip_address inet [note: 'IP that requested reset']
  user_agent text

  // Status and Timing
  is_used boolean [default: false]
  used_at timestamptz
  expires_at timestamptz [not null]

  // Attempt Tracking
  attempts integer [default: 0]
  max_attempts integer [default: 3]

  created_at timestamptz [default: 'now()']

  indexes {
    user_id [name: 'idx_password_reset_user']
    token_hash [unique, name: 'idx_password_reset_token']
    expires_at [name: 'idx_password_reset_expires']
    (is_used, expires_at) [name: 'idx_password_reset_status']
  }
}

// API Keys and Service Authentication
Table api_keys as AK {
  id uuid [pk, default: `gen_random_uuid()`]
  restaurant_id text [note: 'Restaurant scope for this API key']

  // Key Information
  key_name text [not null, note: 'Human-readable key name']
  key_hash text [not null, note: 'Hashed API key']
  key_prefix text [not null, note: 'Visible key prefix for identification']

  // Permissions and Scope
  permissions text[] [not null, note: 'Specific API permissions']
  scope text[] [note: 'Allowed endpoints/resources']
  rate_limit integer [default: 1000, note: 'Requests per hour']

  // Usage Tracking
  last_used_at timestamptz
  usage_count bigint [default: 0]
  total_requests bigint [default: 0]

  // Security
  allowed_ips inet[] [note: 'IP whitelist']
  requires_ssl boolean [default: true]

  // Status
  is_active boolean [default: true]
  expires_at timestamptz

  // Audit
  created_by uuid [not null]
  created_at timestamptz [default: 'now()']
  last_rotated_at timestamptz
  deactivated_at timestamptz
  deactivated_by uuid

  indexes {
    restaurant_id [name: 'idx_api_keys_restaurant']
    key_hash [unique, name: 'idx_api_keys_hash']
    key_prefix [name: 'idx_api_keys_prefix']
    created_by [name: 'idx_api_keys_created_by']
    (is_active, expires_at) [name: 'idx_api_keys_status']
  }
}

// Relationships
Ref: U.default_restaurant_id > R.id
Ref: U.created_by > U.id
Ref: U.updated_by > U.id

Ref: R.manager_id > U.id
Ref: R.owner_id > U.id
Ref: R.created_by > U.id
Ref: R.updated_by > U.id

Ref: URA.user_id > U.id
Ref: URA.restaurant_id > R.id
Ref: URA.granted_by > U.id
Ref: URA.revoked_by > U.id

Ref: US.user_id > U.id
Ref: US.restaurant_id > R.id
Ref: US.device_id > RD.id

Ref: RD.user_id > U.id
Ref: RD.restaurant_id > R.id
Ref: RD.deactivated_by > U.id

Ref: AE.user_id > U.id
Ref: AE.restaurant_id > R.id
Ref: AE.session_id > US.id
Ref: AE.device_id > RD.id
Ref: AE.related_event_id > AE.id

Ref: PRT.user_id > U.id

Ref: AK.restaurant_id > R.id
Ref: AK.created_by > U.id
Ref: AK.deactivated_by > U.id